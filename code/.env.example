# Server port
PORT=8080

# Database connection (Neon PostgreSQL pooler or local PostgreSQL)
# Example: jdbc:postgresql://ep-rapid-firefly-aousvely-pooler.c-2.ap-southeast-1.aws.neon.tech/wastelens?sslmode=require
DB_JDBC_URL=jdbc:postgresql://localhost:5432/wastelens
DB_USER=wastelens_app
DB_PASSWORD=your_database_password_here

# Neon Auth (Managed Better Auth) verification
NEON_AUTH_BASE_URL=https://<your-neon-auth-host>/<db-name>/auth
NEON_AUTH_JWKS_URL=https://<your-neon-auth-host>/<db-name>/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://<your-neon-auth-host>
VITE_NEON_AUTH_URL=https://<your-neon-auth-host>/<db-name>/auth

# Alternatively: Supabase Auth ES256 verification
# SUPABASE_ISSUER=https://<your-project-ref>.supabase.co/auth/v1
# SUPABASE_JWKS_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_AUDIENCE=authenticated
